rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasUserProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserData() {
      return currentUserDoc().data;
    }

    function roleList() {
      return hasUserProfile()
        ? (currentUserData().role is list
          ? currentUserData().role
          : (currentUserData().role is string ? [currentUserData().role] : []))
        : [];
    }

    function hasAnyRole(roles) {
      return hasUserProfile() && roleList().hasAny(roles);
    }

    function isAdmin() {
      return hasAnyRole(['admin']);
    }

    // Toda variante de "pós graduando" precisa estar aqui: a tela de gestão de
    // equipe grava a role com acento e espaço ("pós graduando"), e é essa lista
    // que libera a leitura da coleção `users`. Sem ela, quem é só pós-graduando
    // abre a Nova Entrada com os selects de docente e pós vazios, e a página de
    // Admin sem ninguém na lista.
    function isStaff() {
      return hasAnyRole([
        'admin',
        'professor',
        'pos-graduando',
        'pos graduando',
        'pos_graduando',
        'posgraduando',
        'pós-graduando',
        'pós graduando',
        'graduando',
        'estagiario'
      ]);
    }

    // Quem responde pelo laudo: libera e exclui casos. Estagiário fica de fora
    // (é o papel padrão de quem acaba de se cadastrar).
    function isLaudoManager() {
      return hasAnyRole([
        'admin',
        'professor',
        'pos-graduando',
        'pos graduando',
        'pos_graduando',
        'posgraduando',
        'pós-graduando',
        'pós graduando'
      ]);
    }

    function isApprovedUser() {
      return hasUserProfile() && currentUserData().status != 'pending';
    }

    function isProfessor() {
      return hasAnyRole(['professor', 'professores']);
    }

    // Aprovar o cadastro de alguém: tirar a conta de 'pending' e entregar a
    // role de entrada. É o único poder do professor sobre a conta alheia —
    // promover, rebaixar e remover continuam sendo do admin, e o `hasOnly`
    // garante que nenhum outro campo viaje junto na mesma escrita.
    function isAprovacaoDeCadastro(userId) {
      return resource.data.status == 'pending'
        && request.resource.data.status == 'active'
        && request.resource.data.role == ['estagiario']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'role'])
        && request.auth.uid != userId;   // ninguém aprova a si mesmo
    }

    function isInventoryManager() {
      return hasAnyRole([
        'admin',
        'professor',
        'pos-graduando',
        'pos graduando',
        'pos_graduando',
        'posgraduando',
        'pós-graduando',
        'pós graduando'
      ]);
    }

    match /config/registration {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow create: if isSignedIn() && request.auth.uid == userId;

      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isStaff()
      );

      allow update: if isSignedIn() && (
        isAdmin() ||
        (isApprovedUser() && isProfessor() && isAprovacaoDeCadastro(userId)) ||
        (
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.status == resource.data.status
        )
      );

      allow delete: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read: if isApprovedUser();
      allow create, update: if isApprovedUser();
      // Apagar um caso é irreversível e tira a linha do Livro de Registros:
      // vale só para professor, pós e admin, como na ficha.
      allow delete: if isLaudoManager();
    }

    // Índice do Livro de Registros: anos existentes e contagem por ano. Deixa a
    // página montar o filtro de ano e os totais do acervo sem ler o acervo
    // inteiro — só o ano selecionado é carregado.
    match /meta/{docId} {
      allow read: if isApprovedUser();
      allow write: if isApprovedUser();
    }

    // Quem lanca lamina: a bancada. O estagiario entra (e ele quem passa o dia
    // no microtomo) e o pos-graduando fica de fora, por decisao de quem toca o
    // laboratorio. As variantes de grafia estao aqui pelo mesmo motivo de
    // isStaff: a tela de equipe grava a role como a pessoa digitou.
    function isSlideRecorder() {
      return hasAnyRole([
        'admin',
        'professor',
        'professores',
        'estagiario',
        'estagiarios',
        'estagiário',
        'estagiários'
      ]);
    }

    // Producao de laminas: log append-only de corte e coloracao, no mesmo
    // espirito de inventory_events. Cada documento e um protocolo de uma leva;
    // a leva inteira compartilha o loteId, que e o que o "Desfazer" apaga.
    match /slide_records/{recordId} {
      allow read: if isApprovedUser();

      allow create: if isSlideRecorder()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.tipo in ['necropsia', 'biopsia']
        && request.resource.data.acao in ['corte', 'coloracao']
        && request.resource.data.quantidade is number
        && request.resource.data.quantidade > 0
        && request.resource.data.protocolo is string
        && request.resource.data.protocolo.size() > 0
        && request.resource.data.responsavelNome is string
        && request.resource.data.responsavelNome.size() > 0;

      // Lancamento gravado nao se reescreve: erro se corrige desfazendo a leva
      // e lancando de novo, e o log continua contando o que aconteceu.
      allow update: if false;

      allow delete: if isApprovedUser()
        && (resource.data.createdByUid == request.auth.uid || isAdmin());
    }

    // O estoque nao controla saldo: cada item guarda quanto se compra de uma vez
    // e quanto tempo essa quantidade costuma durar. Ninguem lanca consumo, entao
    // so quem responde pelo laboratorio escreve aqui.
    match /inventory_items/{itemId} {
      allow read: if isApprovedUser();

      allow create, update: if isInventoryManager()
        && request.resource.data.referenceQuantity is number
        && request.resource.data.referenceQuantity > 0
        && request.resource.data.referenceDays is number
        && request.resource.data.referenceDays > 0
        && request.resource.data.alertLeadDays is number
        && request.resource.data.alertLeadDays >= 0;

      // Produto que saiu do laboratorio sai do app: sem controle de saldo, nao
      // ha o que preservar num item arquivado.
      allow delete: if isInventoryManager();
    }

    // Linha do tempo do item: compras registradas e conferencias no armario.
    match /inventory_events/{eventId} {
      allow read: if isApprovedUser();

      allow create: if isInventoryManager()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.itemId is string
        && request.resource.data.type in ['compra', 'conferencia'];

      // Registro gravado nao se reescreve; um erro se corrige com um novo
      // registro. A exclusao existe so para acompanhar a do item.
      allow update: if false;
      allow delete: if isInventoryManager();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
