rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasUserProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserData() {
      return currentUserDoc().data;
    }

    function roleList() {
      return hasUserProfile()
        ? (currentUserData().role is list
          ? currentUserData().role
          : (currentUserData().role is string ? [currentUserData().role] : []))
        : [];
    }

    function hasAnyRole(roles) {
      return hasUserProfile() && roleList().hasAny(roles);
    }

    function isAdmin() {
      return hasAnyRole(['admin']);
    }

    function isStaff() {
      return hasAnyRole([
        'admin',
        'professor',
        'pos-graduando',
        'pos_graduando',
        'posgraduando',
        'pós-graduando',
        'graduando',
        'estagiario'
      ]);
    }

    // Quem responde pelo laudo: libera e exclui casos. Estagiário fica de fora
    // (é o papel padrão de quem acaba de se cadastrar).
    function isLaudoManager() {
      return hasAnyRole([
        'admin',
        'professor',
        'pos-graduando',
        'pos graduando',
        'pos_graduando',
        'posgraduando',
        'pós-graduando',
        'pós graduando'
      ]);
    }

    function isApprovedUser() {
      return hasUserProfile() && currentUserData().status != 'pending';
    }

    function isInventoryManager() {
      return hasAnyRole([
        'admin',
        'professor',
        'pos-graduando',
        'pos graduando',
        'pos_graduando',
        'posgraduando',
        'pós-graduando',
        'pós graduando'
      ]);
    }

    match /config/registration {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow create: if isSignedIn() && request.auth.uid == userId;

      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isStaff()
      );

      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.status == resource.data.status
        )
      );

      allow delete: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read: if isApprovedUser();
      allow create, update: if isApprovedUser();
      // Apagar um caso é irreversível e tira a linha do Livro de Registros:
      // vale só para professor, pós e admin, como na ficha.
      allow delete: if isLaudoManager();
    }

    // Índice do Livro de Registros: anos existentes e contagem por ano. Deixa a
    // página montar o filtro de ano e os totais do acervo sem ler o acervo
    // inteiro — só o ano selecionado é carregado.
    match /meta/{docId} {
      allow read: if isApprovedUser();
      allow write: if isApprovedUser();
    }

    match /slide_records/{recordId} {
      allow read, write: if isApprovedUser();
    }

    match /inventory_items/{itemId} {
      allow read: if isApprovedUser();

      allow create: if isInventoryManager()
        && request.resource.data.currentQuantity is number
        && request.resource.data.currentQuantity >= 0
        && request.resource.data.minQuantity is number
        && request.resource.data.minQuantity >= 0;

      allow update: if (
        isInventoryManager()
        && request.resource.data.currentQuantity is number
        && request.resource.data.currentQuantity >= 0
        && request.resource.data.minQuantity is number
        && request.resource.data.minQuantity >= 0
      ) || (
          isApprovedUser()
          && resource.data.active != false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'currentQuantity',
            'lastMovementId',
            'updatedAt',
            'updatedBy',
            'updatedByName'
          ])
          && request.resource.data.currentQuantity is number
          && request.resource.data.currentQuantity >= 0
          && request.resource.data.currentQuantity < resource.data.currentQuantity
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.lastMovementId is string
          && existsAfter(/databases/$(database)/documents/inventory_movements/$(request.resource.data.lastMovementId))
          && getAfter(/databases/$(database)/documents/inventory_movements/$(request.resource.data.lastMovementId)).data.itemId == itemId
          && getAfter(/databases/$(database)/documents/inventory_movements/$(request.resource.data.lastMovementId)).data.type == 'saida'
          && getAfter(/databases/$(database)/documents/inventory_movements/$(request.resource.data.lastMovementId)).data.previousQuantity == resource.data.currentQuantity
          && getAfter(/databases/$(database)/documents/inventory_movements/$(request.resource.data.lastMovementId)).data.resultingQuantity == request.resource.data.currentQuantity
          && getAfter(/databases/$(database)/documents/inventory_movements/$(request.resource.data.lastMovementId)).data.createdBy == request.auth.uid
        );

      // Itens sao arquivados, nunca excluidos, para preservar o historico.
      allow delete: if false;
    }

    match /inventory_movements/{movementId} {
      allow read: if isApprovedUser();

      allow create: if isApprovedUser()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.type in ['entrada', 'saida', 'ajuste']
        && request.resource.data.quantity is number
        && request.resource.data.quantity > 0
        && request.resource.data.delta is number
        && request.resource.data.previousQuantity is number
        && request.resource.data.resultingQuantity is number
        && request.resource.data.resultingQuantity >= 0
        && (
          isInventoryManager() ||
          (
            request.resource.data.type == 'saida'
            && request.resource.data.delta < 0
            && getAfter(/databases/$(database)/documents/inventory_items/$(request.resource.data.itemId)).data.lastMovementId == movementId
          )
        );

      // Movimentacoes sao imutaveis; correcoes devem ser feitas por ajuste.
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
